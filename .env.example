# Variabili PUBBLICHE (finiscono nel bundle del browser: è previsto e sicuro con RLS attiva).
# Lasciale vuote per la modalità "Anteprima locale" (nessun backend, nessun dato inviato).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NON inserire mai qui (né in nessuna variabile VITE_*) la service_role key,
# la password del database o altri segreti: tutto ciò che inizia con VITE_ è pubblico.
